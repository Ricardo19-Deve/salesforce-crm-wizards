<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Set_Name</name>
        <label>Set Name</label>
        <locationX>176</locationX>
        <locationY>431</locationY>
        <assignmentItems>
            <assignToReference>$Record.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>CampaignName</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Is_Sales_Campaign_Without_Type</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Set_Type_Other</name>
        <label>Set Type Other</label>
        <locationX>176</locationX>
        <locationY>755</locationY>
        <assignmentItems>
            <assignToReference>$Record.Type</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Other</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Name_Parts</name>
        <label>Has Name Parts?</label>
        <locationX>308</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Is_Sales_Campaign_Without_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Name_Parts_Filled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Region__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Name_Suffix__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Name</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Sales_Campaign_Without_Type</name>
        <label>Is Sales Campaign Without Type?</label>
        <locationX>308</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Sales_Without_Type</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sales_Campaign</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Type</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Type_Other</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>MAINTAINER NOTES: Before-save flow on Campaign (Event_Campaign and Sales_Campaign record types). Builds Name = Region-Year-Suffix (year of Start Date, today when blank) so names follow one convention whatever the entry point; the record wizard field "Campaign Name" writes Name_Suffix__c. Sales campaigns without a Type get Type = Other. Before-save: no DML, no extra SOQL, bulk-safe. New campaign record types must be added to the start formula.</description>
    <environments>Default</environments>
    <formulas>
        <name>CampaignName</name>
        <dataType>String</dataType>
        <expression>LEFT(TEXT({!$Record.Region__c}) &amp; &quot;-&quot; &amp; TEXT(YEAR(IF(ISBLANK({!$Record.StartDate}), TODAY(), {!$Record.StartDate}))) &amp; &quot;-&quot; &amp; TRIM({!$Record.Name_Suffix__c}), 80)</expression>
    </formulas>
    <interviewLabel>Campaign Set Name {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Campaign - Set Name</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>182</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Name_Parts</targetReference>
        </connector>
        <filterFormula>OR({!$Record.RecordType.DeveloperName} = &quot;Event_Campaign&quot;, {!$Record.RecordType.DeveloperName} = &quot;Sales_Campaign&quot;)</filterFormula>
        <object>Campaign</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
