<apex:page controller="ProjectExportController" action="{!initSprintReport}" renderAs="{!renderAs}" contentType="{!contentType}"
    showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" cache="false">
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title>{!fileName}</title>
    <style type="text/css">
        @page {
            size: A4;
            margin: 18mm 14mm 20mm 14mm;
            @bottom-right {
                content: "Page " counter(page) " of " counter(pages);
                font-family: Arial, Helvetica, sans-serif;
                font-size: 8pt;
            }
        }
        body { font-family: Arial, Helvetica, sans-serif; font-size: 10pt; color: #1a1a1a; }
        p { margin: 0 0 6pt 0; }
        ul { margin: 2pt 0 4pt 0; padding-left: 16pt; }
        li { margin-bottom: 2pt; }
        .page-break { page-break-before: always; }
        .wordmark { color: #1e9bd7; font-weight: bold; font-size: 11pt; letter-spacing: 1pt; }
        .wordmark-big { color: #4d4d4d; font-size: 20pt; letter-spacing: 1pt; }
        .logo { height: 30pt; }
        .logo-big { height: 46pt; }
        .cover { text-align: center; padding-top: 150pt; }
        .doc-title { font-size: 20pt; font-weight: bold; margin: 40pt 0 8pt 0; text-align: center; }
        .doc-sub { font-size: 14pt; font-weight: bold; margin: 26pt 0 50pt 0; text-align: center; }
        .muted { color: #6b6b6b; font-size: 8.5pt; }
        h1.title { font-size: 18pt; margin: 6pt 0 2pt 0; }
        h2.section { color: #1e9bd7; font-size: 14pt; text-decoration: underline; margin: 18pt 0 10pt 0; }
        h3 { font-size: 12pt; margin: 14pt 0 6pt 0; }
        table.grid { width: 100%; border-collapse: collapse; margin: 4pt 0 12pt 0; }
        table.grid th { background: #d9d9d9; border: 1px solid #000000; padding: 4pt 6pt; font-size: 9pt; text-align: left; }
        table.grid td { border: 1px solid #000000; padding: 4pt 6pt; font-size: 9pt; vertical-align: top; }
        table.grid.center th, table.grid.center td { text-align: center; }
        table.narrow { width: 60%; margin-left: 20%; }
        .label-u { text-decoration: underline; }
        .italic { font-style: italic; }
        .toc td { padding: 3pt 0; font-size: 10pt; }
        .toc .toc-section { color: #1e9bd7; font-weight: bold; padding-top: 6pt; }
        .goal { border-left: 3pt solid #1e9bd7; background: #f2f8fc; padding: 6pt 10pt; margin: 8pt 0 12pt 0; }
        table.kpi { width: 100%; border-collapse: separate; border-spacing: 6pt; margin: 6pt 0 10pt 0; }
        table.kpi td { width: 16%; border: 1px solid #c9d6e3; background: #f4f8fc; padding: 8pt; text-align: center; vertical-align: top; }
        .kpi-value { font-size: 18pt; font-weight: bold; color: #0b3d7a; }
        .kpi-label { font-size: 7.5pt; color: #4d5b6b; text-transform: uppercase; }
        .status { font-weight: bold; padding: 1pt 4pt; white-space: nowrap; }
        .tc-block { page-break-inside: avoid; margin-top: 14pt; padding-top: 6pt; border-top: 1px solid #c9d6e3; }
        .status-pass { color: #006644; background: #e3fcef; }
        .status-fail { color: #bf2600; background: #ffebe6; }
        .status-blocked { color: #974f0c; background: #fff4e5; }
        .status-not-run { color: #42526e; background: #ebecf0; }
        .screenshot { max-width: 100%; margin: 6pt 0 2pt 0; border: 1px solid #cccccc; }
        .footer-note { margin-top: 16pt; color: #6b6b6b; font-size: 8pt; }
    </style>
</head>
<body>
    <c:ProjectExportLogo logoUrl="{!logoUrl}" isWord="{!isWord}" />
    <h1 class="title">Sprint Report — {!sprint.Name}</h1>
    <p class="muted">{!project.Name} ({!project.Key__c}) · {!sprintDates} · {!sprint.Status__c} · Generated {!generatedOn} by {!generatedBy}</p>

    <apex:outputPanel layout="block" styleClass="goal" rendered="{!NOT(ISBLANK(sprint.Goal__c))}">
        <strong>Sprint goal:</strong> {!sprint.Goal__c}
    </apex:outputPanel>

    <table class="kpi">
        <tr>
            <td><div class="kpi-value">{!completionPct}%</div><div class="kpi-label">Completion</div></td>
            <td><div class="kpi-value">{!deliveredIssues} / {!committedIssues}</div><div class="kpi-label">Issues delivered</div></td>
            <td>
                <div class="kpi-value"><apex:outputText value="{0,number,#,##0.#}"><apex:param value="{!deliveredPoints}" /></apex:outputText>&#160;/&#160;<apex:outputText value="{0,number,#,##0.#}"><apex:param value="{!committedPoints}" /></apex:outputText></div>
                <div class="kpi-label">Story points</div>
            </td>
            <td><div class="kpi-value">{!bugsFixed}</div><div class="kpi-label">Bugs fixed</div></td>
            <td><div class="kpi-value">{!notDelivered.size}</div><div class="kpi-label">{!IF(sprint.Status__c == 'Completed', 'Carried over', 'Still open')}</div></td>
            <td><div class="kpi-value">{!testPassPct}%</div><div class="kpi-label">Tests passed ({!testsPassed}/{!testsTotal})</div></td>
        </tr>
    </table>

    <h2 class="section">Delivered</h2>
    <apex:outputPanel layout="none" rendered="{!deliveredGroups.size == 0}">
        <p class="muted">No issues were completed in this sprint.</p>
    </apex:outputPanel>
    <apex:repeat value="{!deliveredGroups}" var="g">
        <h3>{!g.name} <span class="muted">(<apex:outputText value="{0,number,#,##0.#}"><apex:param value="{!g.points}" /></apex:outputText> pts)</span></h3>
        <table class="grid">
            <tr><th style="width:11%">Key</th><th style="width:9%">Type</th><th>Summary</th><th style="width:18%">Assignee</th><th style="width:8%">Points</th><th style="width:9%">Tests</th></tr>
            <apex:repeat value="{!g.rows}" var="r">
                <tr><td>{!r.key}</td><td>{!r.type}</td><td>{!r.summary}</td><td>{!r.assignee}</td>
                    <td><apex:outputText value="{0,number,#,##0.#}"><apex:param value="{!r.points}" /></apex:outputText></td><td>{!r.tests}</td></tr>
            </apex:repeat>
        </table>
    </apex:repeat>

    <h2 class="section">{!IF(sprint.Status__c == 'Completed', 'Not delivered / carried over', 'Still open')}</h2>
    <apex:outputPanel layout="none" rendered="{!NOT(hasNotDelivered)}">
        <p class="muted">Everything committed was delivered.</p>
    </apex:outputPanel>
    <apex:outputPanel layout="none" rendered="{!hasNotDelivered}">
        <table class="grid">
            <tr><th style="width:11%">Key</th><th style="width:9%">Type</th><th>Summary</th><th style="width:13%">Status</th><th style="width:18%">Assignee</th><th style="width:8%">Points</th></tr>
            <apex:repeat value="{!notDelivered}" var="r">
                <tr><td>{!r.key}</td><td>{!r.type}</td><td>{!r.summary}</td><td>{!r.status}</td><td>{!r.assignee}</td>
                    <td><apex:outputText value="{0,number,#,##0.#}"><apex:param value="{!r.points}" /></apex:outputText></td></tr>
            </apex:repeat>
        </table>
    </apex:outputPanel>

    <apex:outputPanel layout="none" rendered="{!hasBrds}">
        <h2 class="section">Documentation</h2>
        <table class="grid">
            <tr><th style="width:18%">PBI ID</th><th>BRD</th><th style="width:11%">Issue</th><th style="width:16%">Status</th><th style="width:9%">Version</th></tr>
            <apex:repeat value="{!sprintBrds}" var="b">
                <tr><td>{!b.PBI_ID__c}</td><td>{!b.Name}</td><td>{!b.Issue__r.Name}</td><td>{!b.Status__c}</td><td>{!b.Version__c}</td></tr>
            </apex:repeat>
        </table>
    </apex:outputPanel>
</body>
</html>
</apex:page>
